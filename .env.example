# JDBC_DATABASE_URL=jdbc:postgresql://HOST:5432/DATABASE?sslmode=require
# DB_USER=your_user
# DB_PASSWORD=your_password
# PORT=8081
# Default local storage: H2 file database in ./data
# Hosted portfolio demo: SPRING_PROFILES_ACTIVE=demo (temporary H2 in-memory)
