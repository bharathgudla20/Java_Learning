# Optional external PostgreSQL. Set these in your hosting dashboard, not in Git.
# JDBC_DATABASE_URL=jdbc:postgresql://HOST:5432/DATABASE?sslmode=require
# DB_USER=your_user
# DB_PASSWORD=your_password
# PORT=8081
# Default local storage: H2 file database in ./data
# Hosted application: SPRING_PROFILES_ACTIVE=postgres (persistent PostgreSQL)
# MIGRATION_DATABASE_URL=jdbc:postgresql://DIRECT_HOST:5432/DATABASE?sslmode=require
# JDBC_DATABASE_URL may use a pooled host; migrations must use a direct host.
