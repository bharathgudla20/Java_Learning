  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "JSESSIONID",
        "description": "HttpOnly session established by demo/register/login."
      }
    },
    "schemas": {
      "Csrf": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "headerName": {
            "type": "string"
          }
        },
        "required": [
          "token",
          "headerName"
        ]
      },
      "Account": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "demo": {
            "type": "boolean"
          },
          "ephemeral": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "demo",
          "ephemeral"
        ]
      },
      "Register": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 64,
            "description": "Maximum 72 UTF-8 bytes"
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "Login": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "ProductInput": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{2,32}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "price": {
            "type": "number",
            "multipleOf": 0.01,
            "minimum": 0.01,
            "maximum": 9999999.99
          },
          "stock": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "reorderPoint": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          }
        },
        "required": [
          "sku",
          "name",
          "category",
          "price",
          "stock",
          "reorderPoint"
        ]
      },
      "Product": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "sku": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "multipleOf": 0.01
          },
          "stock": {
            "type": "integer"
          },
          "reorderPoint": {
            "type": "integer"
          },
          "version": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "sku",
          "name",
          "category",
          "price",
          "stock",
          "reorderPoint",
          "version"
        ]
      },
      "StockInput": {
        "type": "object",
        "properties": {
          "change": {
            "type": "integer",
            "minimum": -1000000,
            "maximum": 1000000,
            "description": "Non-zero delta. Resulting stock must be between 0 and 1,000,000."
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "change",
          "reason"
        ]
      },
      "LineInput": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          }
        },
        "required": [
          "productId",
          "quantity"
        ]
      },
      "OrderInput": {
        "type": "object",
        "properties": {
          "customer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "lines": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "items": {
              "$ref": "#/components/schemas/LineInput"
            }
          }
        },
        "required": [
          "customer",
          "email",
          "lines"
        ]
      },
      "OrderLine": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "quantity": {
            "type": "integer"
          },
          "unitPrice": {
            "type": "number",
            "multipleOf": 0.01
          }
        },
        "required": [
          "productId",
          "name",
          "sku",
          "quantity",
          "unitPrice"
        ]
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "reference": {
            "type": "string"
          },
          "customer": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PLACED",
              "SHIPPED",
              "CANCELLED"
            ]
          },
          "total": {
            "type": "number",
            "multipleOf": 0.01
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderLine"
            }
          }
        },
        "required": [
          "id",
          "reference",
          "customer",
          "email",
          "status",
          "total",
          "createdAt",
          "lines"
        ]
      },
      "StatusInput": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "SHIPPED",
              "CANCELLED"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "Activity": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "kind",
          "message",
          "createdAt"
        ]
      },
      "Day": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "revenue": {
            "type": "number",
            "multipleOf": 0.01
          },
          "orders": {
            "type": "integer"
          }
        },
        "required": [
          "date",
          "revenue",
          "orders"
        ]
      },
      "Overview": {
        "type": "object",
        "properties": {
          "revenue": {
            "type": "number",
            "multipleOf": 0.01
          },
          "inventoryValue": {
            "type": "number",
            "multipleOf": 0.01
          },
          "activeProducts": {
            "type": "integer"
          },
          "lowStock": {
            "type": "integer"
          },
          "orders": {
            "type": "integer"
          },
          "pendingOrders": {
            "type": "integer"
          },
          "trend": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Day"
            }
          },
          "stockAlerts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Product"
            }
          },
          "recentOrders": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Order"
            }
          },
          "activity": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Activity"
            }
          }
        },
        "required": [
          "revenue",
          "inventoryValue",
          "activeProducts",
          "lowStock",
          "orders",
          "pendingOrders",
          "trend",
          "stockAlerts",
          "recentOrders",
          "activity"
        ]
      },
      "ProductPage": {
        "type": "object",
        "properties": {
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Product"
            }
          },
          "page": {
            "type": "integer"
          },
          "totalPages": {
            "type": "integer"
          },
          "totalElements": {
            "type": "integer"
          }
        },
        "required": [
          "content",
          "page",
          "totalPages",
          "totalElements"
        ]
      },
      "Problem": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "detail"
        ]
      }
    }
  }
}
